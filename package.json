      "onnxruntime-node": "1.21.0"
    }
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.5",
    "@huggingface/transformers": "^3.8.1",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.0",
    "@langchain/openai": "^1.7.0",
